# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Site Password Protection
NEXT_PUBLIC_SITE_PASSWORD=your_site_password

# DeepL Translation API
DEEPL_API_KEY=your_deepl_api_key

# Note:
# - Get DeepL API key from: https://www.deepl.com/account/summary
# - Free DeepL account allows 500,000 characters per month
# - For production, consider DeepL Pro for higher limits and better SLA

# Password for admin-only actions (archive/restore). Server-side only --
# do NOT add a NEXT_PUBLIC_ prefix.
ADMIN_PASSWORD=your-admin-password

# Supabase database password. Used by scripts/backup-supabase.js (pg_dump)
# to dump the database before the school-year transition. Find/reset it in
# Supabase Dashboard -> Project Settings -> Database.
SUPABASE_PASS=your-supabase-database-password

# Supabase service role key. Used by scripts/backup-supabase.js to download
# every object in the family-images storage bucket. Find it in Supabase
# Dashboard -> Project Settings -> API. Keep this secret -- it bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key